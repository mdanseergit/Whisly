<?xml version="1.0" encoding="utf-8"?>
<!--
   Whisly Auto-Backup Rules (API <= 30):
   Excludes encrypted Room database and downloaded model packs so Keystore-bound
   ciphertext and large binary checkpoints are never backed up to cloud storage.
-->
<full-backup-content>
    <exclude domain="database" path="whisly_offline_db" />
    <exclude domain="database" path="whisly_offline_db-shm" />
    <exclude domain="database" path="whisly_offline_db-wal" />
    <exclude domain="file" path="whisly_models" />
</full-backup-content>
