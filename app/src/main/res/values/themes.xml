<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Post-splash application theme matching Light Background (#FFF9F5) and Deep Cocoa Top Bar (#29211E) -->
    <style name="Theme.MyApplication" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/whisly_light_bg</item>
        <item name="android:colorBackground">@color/whisly_light_bg</item>
        <item name="android:statusBarColor">@color/whisly_deep_brown</item>
        <item name="android:navigationBarColor">@color/whisly_light_bg</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/whisly_light_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/ic_splash_whisly_logo</item>
        <item name="android:windowSplashScreenIconBackgroundColor" tools:targetApi="31">@color/whisly_warm_white</item>
        <item name="android:windowSplashScreenAnimationDuration" tools:targetApi="31">250</item>
    </style>

    <!-- Dedicated Cold-Start Splash Theme (#FFF9F5 Light / #1A1412 Dark + Centered Whisly Logo) -->
    <style name="Theme.Whisly.Starting" parent="Theme.MyApplication">
        <item name="android:windowBackground">@drawable/bg_splash_whisly</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/whisly_light_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/ic_splash_whisly_logo</item>
        <item name="android:windowSplashScreenIconBackgroundColor" tools:targetApi="31">@color/whisly_warm_white</item>
        <item name="android:windowSplashScreenAnimationDuration" tools:targetApi="31">250</item>
    </style>

</resources>
