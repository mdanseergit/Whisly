<?xml version="1.0" encoding="utf-8"?>
<!--
  PHASE 3 — Perfectly Centered Whisly Splash Screen Icon.
  Android 12+ SplashScreen API uses a 108dp adaptive-style icon viewport where the
  inner 66dp circle is guaranteed never to be clipped by the splash mask.
  Placing the 58dp x 58dp Whisly W-ribbon with android:gravity="center" guarantees
  exact horizontal and vertical optical centering on the #F8F2EC splash canvas.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="108dp"
        android:height="108dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="@color/whisly_warm_white" />
            <size
                android:width="108dp"
                android:height="108dp" />
        </shape>
    </item>
    <item
        android:width="58dp"
        android:height="58dp"
        android:drawable="@drawable/whisly_launcher_fg"
        android:gravity="center" />
</layer-list>
