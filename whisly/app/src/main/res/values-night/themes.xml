<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Night / Dark mode post-splash theme (#1A1412 background + #29211E deep cocoa top bar) -->
    <style name="Theme.MyApplication" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/whisly_dark_bg</item>
        <item name="android:colorBackground">@color/whisly_dark_bg</item>
        <item name="android:statusBarColor">@color/whisly_deep_brown</item>
        <item name="android:navigationBarColor">@color/whisly_dark_bg</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/whisly_splash_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/whisly_splash_logo</item>
        <item name="android:windowSplashScreenIconBackgroundColor" tools:targetApi="31">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimationDuration" tools:targetApi="31">250</item>
    </style>

    <!-- Official SplashScreen Base Theme compliant with AndroidX core-splashscreen specification (Night) -->
    <style name="Theme.SplashScreen" parent="android:Theme.Material.NoActionBar">
        <item name="postSplashScreenTheme">@style/Theme.MyApplication</item>
        <item name="windowSplashScreenBackground">@color/whisly_splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/whisly_splash_logo</item>
        <item name="windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="windowSplashScreenAnimationDuration">250</item>
        <item name="android:windowBackground">@drawable/bg_splash_whisly</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/whisly_splash_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/whisly_splash_logo</item>
        <item name="android:windowSplashScreenIconBackgroundColor" tools:targetApi="31">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimationDuration" tools:targetApi="31">250</item>
    </style>

    <style name="Theme.Whisly.Starting" parent="Theme.SplashScreen">
        <item name="postSplashScreenTheme">@style/Theme.MyApplication</item>
        <item name="windowSplashScreenBackground">@color/whisly_splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/whisly_splash_logo</item>
        <item name="windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="windowSplashScreenAnimationDuration">250</item>
        <item name="android:windowBackground">@drawable/bg_splash_whisly</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/whisly_splash_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/whisly_splash_logo</item>
        <item name="android:windowSplashScreenIconBackgroundColor" tools:targetApi="31">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimationDuration" tools:targetApi="31">250</item>
    </style>

</resources>
